# Copy to .env.local and fill in. Never commit real values.

# Google reCAPTCHA v3 — public site key (used in the browser)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Google reCAPTCHA v3 — secret key (server only)
RECAPTCHA_SECRET_KEY=

# Resend (https://resend.com) — API key and addresses for the contact form
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Codeller <no-reply@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional: Google Analytics 4 measurement ID, loaded only after cookie consent
NEXT_PUBLIC_GA_ID=
